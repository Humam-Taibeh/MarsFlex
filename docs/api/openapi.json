  "components": {
    "schemas": {
      "Activity": {
        "properties": {
          "lon": {
            "type": "number",
            "exclusiveMaximum": 360.0,
            "minimum": 0.0,
            "title": "Lon"
          },
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          },
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Id"
          },
          "dwell_min": {
            "type": "number",
            "maximum": 1440.0,
            "minimum": 0.0,
            "title": "Dwell Min"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lon",
          "lat",
          "id",
          "dwell_min"
        ],
        "title": "Activity"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MetabolicMission": {
        "properties": {
          "position": {
            "$ref": "#/components/schemas/Position"
          },
          "habitat": {
            "$ref": "#/components/schemas/Position"
          },
          "remaining_min": {
            "type": "number",
            "maximum": 1440.0,
            "exclusiveMinimum": 0.0,
            "title": "Remaining Min"
          },
          "time_contingency_min": {
            "type": "number",
            "maximum": 1440.0,
            "minimum": 0.0,
            "title": "Time Contingency Min",
            "default": 0
          },
          "activities": {
            "items": {
              "$ref": "#/components/schemas/Activity"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Activities"
          },
          "parameters": {
            "$ref": "#/components/schemas/MetabolicParameters"
          },
          "resources": {
            "$ref": "#/components/schemas/MetabolicResources"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "position",
          "habitat",
          "remaining_min"
        ],
        "title": "MetabolicMission"
      },
      "MetabolicParameters": {
        "properties": {
          "basal_rate_W": {
            "type": "number",
            "maximum": 5000.0,
            "exclusiveMinimum": 0.0,
            "title": "Basal Rate W",
            "default": 150
          },
          "walk_rate_W_per_m_s": {
            "type": "number",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Walk Rate W Per M S",
            "default": 200
          },
          "slope_rate_W_per_deg": {
            "type": "number",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Slope Rate W Per Deg",
            "default": 300
          },
          "suit_penalty_W": {
            "type": "number",
            "maximum": 5000.0,
            "minimum": 0.0,
            "title": "Suit Penalty W",
            "default": 85
          },
          "nominal_speed_m_s": {
            "type": "number",
            "maximum": 5.0,
            "exclusiveMinimum": 0.0,
            "title": "Nominal Speed M S",
            "default": 0.5
          },
          "uphill_speed_weight": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Uphill Speed Weight",
            "default": 4
          },
          "downhill_speed_weight": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Downhill Speed Weight",
            "default": 2
          },
          "soil_speed_factor": {
            "type": "number",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Soil Speed Factor",
            "default": 1
          },
          "joint_torque_Nm": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Joint Torque Nm"
          },
          "joint_angular_speed_rad_s": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 20.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Joint Angular Speed Rad S"
          },
          "joint_efficiency": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Joint Efficiency"
          },
          "dwell_power_W": {
            "type": "number",
            "maximum": 5000.0,
            "exclusiveMinimum": 0.0,
            "title": "Dwell Power W",
            "default": 150
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "MetabolicParameters"
      },
      "MetabolicResources": {
        "properties": {
          "oxygen": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResourceBalance"
              },
              {
                "type": "null"
              }
            ]
          },
          "water": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResourceBalance"
              },
              {
                "type": "null"
              }
            ]
          },
          "battery": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResourceBalance"
              },
              {
                "type": "null"
              }
            ]
          },
          "oxygen_energy_kJ_per_kg": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Oxygen Energy Kj Per Kg"
          },
          "cooling_water_kg_per_MJ": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cooling Water Kg Per Mj"
          },
          "equipment_power_W": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Equipment Power W"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "MetabolicResources"
      },
      "Mission": {
        "properties": {
          "position": {
            "$ref": "#/components/schemas/Position"
          },
          "habitat": {
            "$ref": "#/components/schemas/Position"
          },
          "remaining_min": {
            "type": "number",
            "maximum": 1440.0,
            "exclusiveMinimum": 0.0,
            "title": "Remaining Min"
          },
          "reserve_min": {
            "type": "number",
            "maximum": 1440.0,
            "minimum": 0.0,
            "title": "Reserve Min"
          },
          "activities": {
            "items": {
              "$ref": "#/components/schemas/Activity"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Activities"
          },
          "detour": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Position"
              },
              {
                "type": "null"
              }
            ]
          },
          "detour_dwell_min": {
            "type": "number",
            "maximum": 1440.0,
            "minimum": 0.0,
            "title": "Detour Dwell Min",
            "default": 10
          },
          "include_field": {
            "type": "boolean",
            "title": "Include Field",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "position",
          "habitat",
          "remaining_min",
          "reserve_min"
        ],
        "title": "Mission"
      },
      "Position": {
        "properties": {
          "lon": {
            "type": "number",
            "exclusiveMaximum": 360.0,
            "minimum": 0.0,
            "title": "Lon"
          },
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lon",
          "lat"
        ],
        "title": "Position"
      },
      "ResourceBalance": {
        "properties": {
          "remaining": {
            "type": "number",
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Remaining"
          },
          "reserve": {
            "type": "number",
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Reserve",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "remaining"
        ],
        "title": "ResourceBalance"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}