{
  // Deploy:  cd cloudflare && npx wrangler deploy
  "name": "marsflex",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "../build",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*"]
  },
  "vars": {
    // Address of the running Python API. Replace after you create the Hugging Face Space.
    "API_ORIGIN": "https://YOUR-NAME-marsflex.hf.space"
  }
}
